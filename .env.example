# ==================== Discord ====================
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Optional: for faster command refresh while testing
GUILD_ID=YOUR_TEST_GUILD_ID_HERE

# Optional: ID kamu sendiri agar bisa bypass akses Admin (meskipun kamu bukan Admin di server)
OWNER_ID=

# ==================== Lavalink ====================
# NOTE: Lavalink server must be running separately (same host or another server).
LAVALINK_NAME=local
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333

# Must match `lavalink.server.password` in Lavalink's application.yml.
# Do NOT use "youshallnotpass" — that is Lavalink's documented default, so it is
# the first thing anyone port-scanning 2333 will try. Generate a random value:
#   openssl rand -hex 24
LAVALINK_PASSWORD=CHANGE_ME_openssl_rand_hex_24
LAVALINK_SECURE=false

# ==================== Optional ====================
# Default volume when player is created
DEFAULT_VOLUME=60

# How long (seconds) bot will wait in voice channel after queue empty (when 24/7 is OFF)
LEAVE_TIMEOUT_SEC=120

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ==================== Prefix Commands ====================
# Prefix untuk text commands (default: .)
# Contoh: .p untuk play, .s untuk skip, .q untuk queue
PREFIX=.

# ==================== Spotify (Optional) ====================
# Get from https://developer.spotify.com/dashboard
#
# These are consumed by LAVALINK, not by the bot. Lavalink's application.yml
# references them as ${SPOTIFY_CLIENT_ID} / ${SPOTIFY_CLIENT_SECRET}, so they
# must be present in the ENVIRONMENT OF THE LAVALINK PROCESS.
# For PM2: pass them in the ecosystem file, or `pm2 restart lavalink --update-env`
# after exporting them. Setting them only in the bot's .env is NOT enough.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: sp_dc cookie of a PERSONAL Spotify account, used only for the lyrics
# endpoint. This is a credential — rotating it signs that account out. Leave
# empty to disable Spotify lyrics; playback still works via clientId/secret.
SPOTIFY_SP_DC=

# Optional but recommended: user-level token that lets the bot read ANY public
# playlist (without it, other people's playlists return 403).
# Generate once on YOUR PC (not the VPS) with:  node scripts/spotify-oauth.js
# The script opens a browser on http://127.0.0.1:8889/callback, so it needs the
# browser and the script on the SAME machine. Register that exact URL under
# Redirect URIs in the Spotify dashboard first. Then copy the value it writes
# here into the VPS's .env — the token is not machine-bound.
SPOTIFY_REFRESH_TOKEN=

# ==================== AI Features (Optional) ====================
# NVIDIA API Key untuk fitur AI Playlist Generator (/aiplaylist) & Roast (/roast)
# Get from https://build.nvidia.com/
# Model: qwen/qwen3-next-80b-a3b-instruct
NVIDIA_API_KEY=

# TokenRouter API Key (alternative AI provider, OpenAI-compatible)
# Get from https://www.tokenrouter.com/
# Base URL: https://api.tokenrouter.com/v1
# Model: MiniMax-M3
TOKENROUTER_API_KEY=

# Default AI provider when booting (overridden by /ai-set provider)
# Options: nvidia | tokenrouter
AI_DEFAULT_PROVIDER=nvidia

# Default AI model when booting (overridden by /ai-set model)
# Leave empty to use the provider's hardcoded default
AI_DEFAULT_MODEL=

