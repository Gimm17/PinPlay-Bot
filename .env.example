# ==================== Discord ====================
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Optional: for faster command refresh while testing
GUILD_ID=YOUR_TEST_GUILD_ID_HERE

# Optional: ID kamu sendiri agar bisa bypass akses Admin (meskipun kamu bukan Admin di server)
OWNER_ID=

# ==================== Lavalink ====================
# NOTE: Lavalink server must be running separately (same host or another server).
LAVALINK_NAME=local
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333

# Must match `lavalink.server.password` in Lavalink's application.yml.
# Do NOT use "youshallnotpass" — that is Lavalink's documented default, so it is
# the first thing anyone port-scanning 2333 will try. Generate a random value:
#   openssl rand -hex 24
LAVALINK_PASSWORD=CHANGE_ME_openssl_rand_hex_24
LAVALINK_SECURE=false

# ==================== Optional ====================
# Default volume when player is created
DEFAULT_VOLUME=60

# How long (seconds) bot will wait in voice channel after queue empty (when 24/7 is OFF)
LEAVE_TIMEOUT_SEC=120

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ==================== Prefix Commands ====================
# Prefix untuk text commands (default: .)
# Contoh: .p untuk play, .s untuk skip, .q untuk queue
PREFIX=.

# ==================== Spotify (Optional) ====================
# Get from https://developer.spotify.com/dashboard
#
# These are consumed by LAVALINK, not by the bot. Lavalink's application.yml
# references them as ${SPOTIFY_CLIENT_ID} / ${SPOTIFY_CLIENT_SECRET}, so they
# must be present in the ENVIRONMENT OF THE LAVALINK PROCESS.
# For PM2: pass them in the ecosystem file, or `pm2 restart lavalink --update-env`
# after exporting them. Setting them only in the bot's .env is NOT enough.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: sp_dc cookie of a PERSONAL Spotify account, used only for the lyrics
# endpoint. This is a credential — rotating it signs that account out. Leave
# empty to disable Spotify lyrics; playback still works via clientId/secret.
SPOTIFY_SP_DC=

# Optional: user-level OAuth token. Generate once on YOUR PC (not the VPS) with
#   node scripts/spotify-oauth.js
# The script opens a browser on http://127.0.0.1:8889/callback, so the browser
# and the script must be on the SAME machine. Register that exact URL under
# Redirect URIs in the Spotify dashboard first. The resulting token is not
# machine-bound — copy it into the VPS's .env.
#
# WHAT IT ACTUALLY BUYS YOU (verified 2026-09-12): it does NOT unlock other
# people's playlists. Since Spotify's Feb 2026 dev-mode change, playlist items
# are returned only for playlists the authenticated account OWNS or COLLABORATES
# on; other playlists return 403 with this token AND with client credentials
# alike. So this is only worth setting if the Spotify account used for the OAuth
# login has playlists of its own (or collaborator access) that the bot must read.
SPOTIFY_REFRESH_TOKEN=

# ==================== AI Features ====================
# --- LimitRouter (main provider) ---
# Docs: https://limitrouter.com/docs
# Base URL: https://limitrouter.com/v1
# Serves many models (gemini-*, claude-*, gpt-*, deepseek-*, kimi-*, grok-*, ...).
# Which models exist is queryable: GET /v1/models with the same key.
LIMITROUTER_API_KEY=

# --- Backup providers (optional; used when the main provider fails) ---
# NVIDIA API Key — get from https://build.nvidia.com/
NVIDIA_API_KEY=

# TokenRouter API Key — get from https://www.tokenrouter.com/
# Base URL: https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=

# Default AI provider when booting.
# NOTE: /ai-set provider and /ai-set model OVERRIDE this at runtime — the value
# is only a cold-start fallback for a fresh data/aiSettings.json.
# Options: limitrouter | nvidia | tokenrouter
AI_DEFAULT_PROVIDER=limitrouter

# Default AI model when booting (overridden by /ai-set model)
# Leave empty to use the provider's hardcoded default
AI_DEFAULT_MODEL=

